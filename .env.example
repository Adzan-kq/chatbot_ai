# Copy to .env.local and fill in.

# Production webhook URL of the n8n workflow (workflow must be Active).
# For testing in the n8n editor use the /webhook-test/... URL instead.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chatbot

# Optional: if the n8n Webhook node uses "Header Auth", set the same value here.
N8N_WEBHOOK_HEADER=X-Webhook-Secret
N8N_WEBHOOK_SECRET=

# Optional: how long to wait for n8n + Ollama (ms). Local models can be slow.
N8N_TIMEOUT_MS=120000
